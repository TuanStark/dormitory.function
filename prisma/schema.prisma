// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums
enum Gender {
  Male
  Female
  Other
}

enum RoomGender {
  Male
  Female
  Mixed
}

enum RoomStatus {
  available
  full
  under_maintenance
}

enum BookingStatus {
  pending
  approved
  rejected
  canceled
}

enum PaymentMethod {
  cash
  bank_transfer
}

enum PaymentStatus {
  unpaid
  paid
}

enum ReportStatus {
  unresolved
  in_progress
  resolved
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum PostStatus {
  public
  draft
  hidden
}

// Models
model Role {
  id     Int     @id @default(autoincrement())
  name   String?  @db.VarChar(100)
  status Boolean? @default(true)
  users  User[]
}

model University {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(150)
  code     String?  @unique @db.VarChar(50)
  address  String? @db.Text
  status   Boolean? @default(true)
  students User[]
}

model User {
  id           Int           @id @default(autoincrement())
  fullName     String?        @db.VarChar(100)
  email        String        @unique @db.VarChar(100)
  password     String        @db.VarChar(255)
  phoneNumber  String?        @db.VarChar(15)
  roleId       Int
  gender       Gender?
  citizenId    String?        @unique @db.VarChar(12)
  universityId Int?
  FacebookId   String?        @unique @db.VarChar(255)
  GoogleId     String?        @unique @db.VarChar(255)
  profileImage String?        @db.VarChar(255)
  dateOfBirth  DateTime?
  address      String?        @db.VarChar(255)
  status       Boolean?      @default(true)
  isVerified   Boolean?      @default(false)
  role         Role?          @relation(fields: [roleId], references: [id])
  university   University?    @relation(fields: [universityId], references: [id])
  bookings     RoomBooking[]
  reports      Report[]
  reviews      Review[]
  posts        Post[]
  createAt     DateTime      @default(now())
  updateAt     DateTime      @updatedAt
}

model Building {
  id          Int      @id @default(autoincrement())
  name        String?   @db.VarChar(100)
  image       String?  @db.VarChar(255)
  description String?  @db.Text
  latitude    Float
  address     String?  @db.VarChar(255)
  longitude   Float
  floors      Int
  averageRating     Float          @db.Float @default(0)
  fiveStar   Int @default(0)
  fourStar   Int @default(0)
  threeStar  Int @default(0)
  twoStar    Int @default(0)
  oneStar    Int @default(0)
  rooms       Room[]
  createAt    DateTime @default(now())
  updateAt    DateTime @updatedAt
}

model Room {
  id               Int           @id @default(autoincrement())
  buildingId       Int
  roomNumber       String?        @db.VarChar(20)
  floor            Int
  description      String?       @db.Text
  capacity         Int
  currentOccupants Int           @default(0)
  gender           RoomGender
  price            Decimal       @db.Decimal(10, 2)
  status           RoomStatus
  building         Building      @relation(fields: [buildingId], references: [id])
  bookings         RoomBooking[]
  images           RoomImage[]
  amenities        RoomAmenity[]
  reviews          Review[]
  reports          Report[]
  createAt         DateTime      @default(now())
  updateAt         DateTime      @updatedAt
}

model RoomImage {
  id          Int      @id @default(autoincrement())
  roomId      Int
  url         String?   @db.VarChar(255)
  description String?  @db.VarChar(255)
  uploadedAt  DateTime @default(now())
  room        Room     @relation(fields: [roomId], references: [id])
  createAt    DateTime @default(now())
  updateAt    DateTime @updatedAt
}

model RoomAmenity {
  id          Int      @id @default(autoincrement())
  roomId      Int
  amenityName String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  createAt    DateTime @default(now())
  updateAt    DateTime @updatedAt
  room        Room     @relation(fields: [roomId], references: [id])
}

model RoomBooking {
  id           Int           @id @default(autoincrement())
  userId       Int
  roomId       Int
  bookingDate  DateTime      @db.Date
  status       BookingStatus
  checkInDate  DateTime      @db.Date
  stayDuration Int?
  totalAmount  Float         @default(0)
  createAt     DateTime      @default(now())
  updateAt     DateTime      @updatedAt

  user    User      @relation(fields: [userId], references: [id])
  room    Room      @relation(fields: [roomId], references: [id])
  payment Payment[]
}

model Payment {
  id            Int           @id @default(autoincrement())
  paymentCode   String?
  bookingId     Int
  amount        Decimal       @db.Decimal(10, 2)
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus
  imageUrl      String?       @db.Text
  metadata      String?       @db.Text
  createAt      DateTime      @default(now())
  updateAt      DateTime      @updatedAt

  booking RoomBooking @relation(fields: [bookingId], references: [id])
}

model Report {
  id         Int          @id @default(autoincrement())
  senderId   Int
  roomId     Int
  content    String       @db.Text
  reportDate DateTime     @default(now())
  status     ReportStatus
  createAt   DateTime     @default(now())
  updateAt   DateTime     @updatedAt

  sender User @relation(fields: [senderId], references: [id])
  room   Room @relation(fields: [roomId], references: [id])
}

model Review {
  id         Int          @id @default(autoincrement())
  userId     Int
  roomId     Int          
  rating     Int          @default(0)
  content    String?      @db.Text
  reviewDate DateTime     @default(now())
  status     ReviewStatus
  createAt   DateTime     @default(now())
  updateAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])
}

model Post {
  id       Int        @id @default(autoincrement())
  userId   Int
  title    String?     @db.VarChar(255)
  content  String?    @db.Text
  image    String?    @db.VarChar(255)
  description String?  @db.Text
  postedAt DateTime   @default(now())
  status   PostStatus
  createAt DateTime   @default(now())
  updateAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
}
